{
  "name": "@dop/core-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local:start": "node scripts/local/runtime.mjs start",
    "local:stop": "node scripts/local/runtime.mjs stop",
    "local:status": "node scripts/local/runtime.mjs status",
    "build": "tsc -p tsconfig.json",
    "eval:classification": "node dist/src/evaluation/run-classification-evaluation.js",
    "eval:cloud-pipeline": "node dist/src/evaluation/run-cloud-pipeline-evaluation.js",
    "eval:cloud-safety": "node dist/src/evaluation/run-cloud-safety-regression.js",
    "eval:runtime-pipeline": "node dist/src/evaluation/run-runtime-pipeline-evaluation.js",
    "eval:m15-onboarding": "node dist/src/evaluation/run-m15-onboarding-regression.js",
    "eval:m16-case-plan": "node dist/src/evaluation/run-m16-case-plan-regression.js",
    "eval:m17-work-package": "node dist/src/evaluation/run-m17-work-package-regression.js",
    "eval:m18-classification-profile": "node dist/src/evaluation/run-m18-classification-profile-regression.js",
    "eval:m19-classifier-release": "node dist/src/evaluation/run-m19-classifier-release-regression.js",
    "eval:m20-source-connectors": "node dist/src/evaluation/run-m20-source-connector-regression.js",
    "eval:m21-connector-binding": "node dist/src/evaluation/run-m21-connector-binding-regression.js",
    "eval:m22-connector-envelope": "node dist/src/evaluation/run-m22-connector-envelope-regression.js",
    "eval:m23-adapter-replay": "node dist/src/evaluation/run-m23-adapter-replay-regression.js",
    "eval:m24-completeness": "node dist/src/evaluation/run-m24-completeness-regression.js",
    "eval:m44-classification-quality": "node dist/src/evaluation/run-m44-classification-quality.js",
    "migration:ledger": "node dist/src/tools/migration-ledger.js",
    "microsoft-mail:uat": "node dist/src/tools/microsoft-mail-uat.js",
    "m43:restore-drill": "node dist/src/tools/run-m43-restore-drill.js",
    "m43:storage-reconcile": "node dist/src/tools/run-m43-storage-reconciliation.js",
    "m43:deletion-fixture": "node dist/src/tools/run-m43-deletion-acceptance-fixture.js",
    "m43:controlled-delete": "node dist/src/tools/run-m43-controlled-deletion-acceptance.js",
    "classify:daemon": "node dist/src/classification-daemon-main.js",
    "preserve:daemon": "node dist/src/document-preservation-daemon-main.js",
    "start:runtime": "node dist/src/runtime-main.js",
    "classify:one": "node dist/src/classification-worker-main.js",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "local:setup": "node scripts/local/setup.mjs",
    "local:backup": "node scripts/local/runtime.mjs backup",
    "local:verify": "node scripts/local/verify-closeout.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "pdf-lib": "1.17.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.16.0"
}
